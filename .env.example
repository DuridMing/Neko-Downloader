# Neko Downloader 設定範例
# 複製為 .env 後修改：cp .env.example .env
#
# 這是這個服務**唯一**的設定檔（沒有 config.json 了）。放在專案根目錄或 backend/ 皆可；
# Docker 會把它唯讀掛進容器的 /srv/.env。真的環境變數仍會覆蓋這裡的值。

# 同時下載的任務數
MAX_CONCURRENT=2

# 佇列上限，滿了回 429
MAX_QUEUE_SIZE=50

# 完成檔案的保留秒數，逾時自動刪除（失敗/取消的記錄同樣依此 TTL 從佇列消失）
FILE_TTL_SECONDS=3600

# 清理排程的掃描間隔（秒）
CLEANUP_INTERVAL_SECONDS=60

# 瀏覽器嗅探的等待上限（秒）：載入網頁後等待媒體串流請求出現的時間
SNIFF_TIMEOUT_SECONDS=20

# Netscape 格式的 cookies 檔路徑（選填）：抓取需要登入的內容時使用
# （如私人 Facebook/X/TikTok 貼文）。可用 ./scripts/get-cookies.sh 互動式登入產生，
# 或瀏覽器擴充功能「Get cookies.txt」匯出
#COOKIES_FILE=/path/to/cookies.txt

# 或直接讀取本機瀏覽器的登入 cookies（選填，僅限主機直裝、瀏覽器在同一台機器）
# 支援 chrome / firefox / edge / brave / chromium…，可加 profile 如 "chrome:Profile 1"
# 兩者都設時以 COOKIES_FILE 優先
#COOKIES_FROM_BROWSER=firefox

# 審查日誌檔路徑（JSON Lines 格式，自動輪替 10MB x 5）
# 相對路徑以 backend/ 為基準；設為空字串可停用檔案輸出（stdout 仍會輸出）
AUDIT_LOG_FILE=logs/audit.log

# 暫存目錄（docker-compose 把宿主機的 /var/tmp/neko_dl 掛到這裡）
TMP_DIR=/tmp/neko_dl

# 服務埠。主機直裝＝服務實際監聽的埠；Docker＝發佈到宿主機的埠
# （容器內固定 8000，改這裡等於改 compose 的 port mapping 左邊）
PORT=8000

# ── 存取密碼（強烈建議設定）──
# NONE＝不驗證（預設）。改成任何其他值就會啟用：整個 API 與 WebSocket 都要先用這組
# 密碼解鎖（網頁會跳解鎖畫面），瀏覽器記住 30 天。
# 這是唯一擋住「同網段任何人都能刪你的 Telegram 登入、看你抓了什麼」的東西；
# 但 HTTP 是明文，網段不可信時請另外加 TLS。
ACCESS_PASSWORD=NONE

# ── Telegram 頻道抓取（MTProto，使用者本人帳號；留空則停用此分支）──
# 到 https://my.telegram.org/apps 申請取得
#TELEGRAM_API_ID=1234567
#TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# session 檔存放目錄（相對路徑以 backend/ 為基準）。
# 此檔等同帳號完整存取權：目錄強制 0700、檔案 0600，
# 不會進資料庫／日誌／API 回應，也請勿納入一般備份。
# 切勿指向 TMP_DIR，那裡開機就會被清空。
TELEGRAM_SESSION_DIR=.secrets
TELEGRAM_SESSION_NAME=neko_user

# ── macvlan 部署專用（搭配 docker-compose.macvlan.yml，bridge 模式不需要）──
# 實體網卡名稱（用 `ip link` 查詢）
MACVLAN_PARENT=eth0
# 區網網段與閘道
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1
# 分配給容器的固定 IP（避開 DHCP 派發範圍）
MACVLAN_IP=192.168.1.50
